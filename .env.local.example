# Environment Variables for Sino Technology Solutions
# Copy this file to .env.local and fill in the values

# Documented canonical host. SEO URLs are set in content/site.ts (siteUrl).
# Point the apex domain at this host with a permanent (308) redirect in Vercel.
NEXT_PUBLIC_SITE_URL=https://www.sinotechsol.com

# Contact form email (Resend). Verify sinotechsol.com in Resend before production sends.
RESEND_API_KEY=
# Verified sender, for example: Sino Technology Solutions <info@sinotechsol.com>
RESEND_FROM_EMAIL=
# Inbox that receives form submissions.
CONTACT_EMAIL=info@sinotechsol.com

# Sanity CMS Configuration (get from https://sanity.io)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
